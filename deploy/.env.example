# Copy to deploy/.env (not committed) and fill in. See README.md.

# The site's hostname. With no domain of your own, use the VM's public IP with dashes plus .sslip.io,
# e.g. 129-146-12-34.sslip.io for 129.146.12.34. Caddy gets an HTTPS certificate for it automatically.
SITE_ADDRESS=129-146-12-34.sslip.io

# Username and password visitors enter. Store the password as a bcrypt hash, made with:
#   docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes around the hash: it contains $ signs, which Docker Compose would otherwise expand.
SITE_USER=capstone
SITE_PASSWORD_HASH='paste the hash here'
